# ---------------------------------------------------------------------------
# Call Doc — environment. Copy to .env and adjust. Every value here is $0.
# ---------------------------------------------------------------------------

# --- API server ---
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# --- Postgres + pgvector ---
# Local docker compose default. Swap for a Supabase/Neon free-tier URL in prod.
DATABASE_URL=postgres://calldoc:calldoc@localhost:5432/calldoc

# --- Ollama (local open-weights LLM) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_MS=30000
# When false the NLU falls back to the deterministic keyword classifier only.
# Useful for CI and for hosts without an Ollama daemon.
LLM_ENABLED=true

# --- OpenStreetMap ---
# Overpass + Nominatim usage policies REQUIRE an identifying User-Agent with a
# contact address. Requests without one get blocked. Set this before ingesting.
OSM_USER_AGENT=CallDoc/0.1 (contact: you@example.com)
OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Nominatim policy: max 1 request/second.
NOMINATIM_MIN_INTERVAL_MS=1100

# --- Ingestion ---
# Key from packages/api/src/ingest/cities.ts
INGEST_CITY=kolkata
INGEST_MAX_FACILITIES=5000

# --- Embeddings (V2 RAG layer) ---
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIM=384
RAG_ENABLED=true

# --- Search defaults ---
DEFAULT_RADIUS_KM=8
MAX_RADIUS_KM=25
MAX_RESULTS=5

# --- Foursquare (optional, V2 secondary source) ---
# Free tier, no card required. Leave blank to skip.
FOURSQUARE_API_KEY=
